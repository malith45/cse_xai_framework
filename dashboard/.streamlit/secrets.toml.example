# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Community Cloud → App settings → Secrets.
# NEVER commit secrets.toml.

PASSCODE = "change-me"

# "mock" (default) or "postgres". Drives both the repository factory and the
# DEMONSTRATION DATA banner.
DATA_SOURCE = "mock"

# Only needed when DATA_SOURCE = "postgres". Use a READ-ONLY role.
# DATABASE_URL = "postgresql://readonly_user:password@host/dbname?sslmode=require"
